rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // Учитель = пользователь, для которого вручную создан документ teachers/{его uid}.
    // (В консоли Firebase учитель и так видит всё — это задел под будущую страницу учителя.)
    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // Профиль ученика: имя, логин, звёзды по уровням, статистика по шагам и типам ошибок.
    match /students/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow create, update: if isOwner(uid);

      // Подколлекции: sessions, errors, results — ученик пишет только в свои.
      match /{sub}/{id} {
        allow read: if isOwner(uid) || isTeacher();
        allow create, update: if isOwner(uid) && sub in ['sessions', 'errors', 'results'];
      }
    }

    match /teachers/{uid} {
      allow read: if isOwner(uid);
    }
  }
}
